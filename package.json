{
  "name": "japango",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "map:area": "bun scripts/add-area.mjs",
    "map:all": "bun scripts/fetch-all.mjs",
    "map:fetch": "bun scripts/fetch-osm.mjs",
    "map:build": "bun scripts/build-map.mjs && bun scripts/build-tiles.mjs",
    "map:mapillary": "bun scripts/fetch-mapillary.mjs",
    "map:people": "bun scripts/fetch-people.mjs",
    "map:plateau": "bun scripts/fetch-plateau.mjs",
    "map:terrain": "bun scripts/fetch-terrain.mjs",
    "map:bridges": "bun scripts/fetch-bridges.mjs",
    "map:wiki": "bun scripts/fetch-wiki.mjs",
    "map:aerial": "bun scripts/fetch-aerial.mjs",
    "map:dict": "bun scripts/build-dict.mjs",
    "map:sounds": "bun scripts/fetch-sounds.mjs",
    "map:tiles": "bun scripts/build-tiles.mjs",
    "life:places": "bun scripts/life/places.mjs",
    "life:write": "bun scripts/life/write-life.mjs",
    "life:plan": "bun scripts/life/plan.mjs",
    "cf:dev": "vite build && wrangler d1 migrations apply japango --local && wrangler dev"
  },
  "dependencies": {
    "@fontsource-variable/m-plus-1": "^5.3.1",
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/press-start-2p": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "kuromoji": "^0.1.2",
    "oxlint": "^1.90.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.166.0"
  }
}
